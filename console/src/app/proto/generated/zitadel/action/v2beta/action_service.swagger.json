{
  "swagger": "2.0",
  "info": {
    "title": "Action Service",
    "description": "This API is intended to manage custom executions (previously known as actions) in a Zitadel instance. This service is in beta state. It can AND will continue breaking until a stable version is released.",
    "version": "2.0-beta",
    "contact": {
      "name": "ZITADEL",
      "url": "https://zitadel.com",
      "email": "hi@zitadel.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://github.com/zitadel/zitadel/blob/main/LICENSING.md"
    }
  },
  "tags": [
    {
      "name": "ActionService"
    }
  ],
  "host": "$CUSTOM_DOMAIN",
  "basePath": "/",
  "schemes": [
    "https",
    "http"
  ],
  "consumes": [
    "application/json",
    "application/grpc",
    "application/grpc-web+proto"
  ],
  "produces": [
    "application/json",
    "application/grpc",
    "application/grpc-web+proto"
  ],
  "paths": {
    "/v2beta/actions/executions": {
      "put": {
        "summary": "Set Execution",
        "description": "Deprecated: please move to the corresponding endpoint under action service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nSets an execution to call a target or include the targets of another execution.\nSetting an empty list of targets will remove all targets from the execution, making it a noop.\n\nRequired permission:\n  - `action.execution.write`",
        "operationId": "ActionService_SetExecution",
        "responses": {
          "200": {
            "description": "Execution successfully updated or left unchanged",
            "schema": {
              "$ref": "#/definitions/actionv2betaSetExecutionResponse"
            }
          },
          "400": {
            "description": "Condition to set execution does not exist or the feature flag `actions` is not enabled.",
            "schema": {}
          },
          "403": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "404": {
            "description": "Returned when the resource does not exist.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/actionv2betaSetExecutionRequest"
            }
          }
        ],
        "tags": [
          "ActionService"
        ],
        "deprecated": true
      }
    },
