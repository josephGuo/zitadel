    "/v2beta/actions/executions/search": {
      "post": {
        "summary": "List Executions",
        "description": "Deprecated: please move to the corresponding endpoint under action service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nList all matching executions. By default all executions of the instance are returned that have at least one execution target.\nMake sure to include a limit and sorting for pagination.\n\nRequired permission:\n  - `action.execution.read`",
        "operationId": "ActionService_ListExecutions",
        "responses": {
          "200": {
            "description": "A list of all non noop executions matching the query",
            "schema": {
              "$ref": "#/definitions/actionv2betaListExecutionsResponse"
            }
          },
          "400": {
            "description": "Invalid list query or the feature flag `actions` is not enabled.",
            "schema": {}
          },
          "403": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {
