        ],
        "deprecated": true
      }
    }
  },
  "definitions": {
    "actionv2betaActionServiceUpdateTargetBody": {
      "type": "object",
      "example": {
        "name": "ip_allow_list",
        "restCall": {
          "interruptOnError": true
        },
        "timeout": "10s",
        "endpoint": "https://example.com/hooks/ip_check",
        "expirationSigningKey": "0s"
      },
      "properties": {
        "name": {
          "type": "string",
          "example": "ip_allow_list",
          "maxLength": 1000,
          "minLength": 1
        },
        "restWebhook": {
          "$ref": "#/definitions/actionv2betaRESTWebhook",
          "description": "Wait for response but response body is ignored, status is checked, call is sent as post."
        },
        "restCall": {
          "$ref": "#/definitions/actionv2betaRESTCall",
          "description": "Wait for response and response body is used, status is checked, call is sent as post."
        },
        "restAsync": {
          "$ref": "#/definitions/actionv2betaRESTAsync",
          "description": "Call is executed in parallel to others, Zitadel does not wait until the call is finished. The state is ignored, call is sent as post."
        },
        "timeout": {
          "type": "string",
          "example": "10s",
          "description": "Timeout defines the duration until Zitadel cancels the execution.\nIf the target doesn't respond before this timeout expires, then the connection is closed and the action fails. Depending on the target type and possible setting on `interrupt_on_error` following targets will not be called. In case of a `rest_async` target only this specific target will fail, without any influence on other targets of the same execution."
        },
        "endpoint": {
          "type": "string",
          "example": "https://example.com/hooks/ip_check",
          "maxLength": 1000,
          "minLength": 1
        },
        "expirationSigningKey": {
          "type": "string",
          "example": "0s",
          "description": "Regenerate the key used for signing and checking the payload sent to the target.\nSet the graceful period for the existing key. During that time, the previous\nsigning key and the new one will be used to sign the request to allow you a smooth\ntransition onf your API.\n\nNote that we currently only allow an immediate rotation (\"0s\") and will support\nlonger expirations in the future."
        }
      }
    },
    "actionv2betaCondition": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/definitions/actionv2betaRequestExecution",
          "description": "Condition-type to execute if a request on the defined API point happens."
        },
        "response": {
          "$ref": "#/definitions/actionv2betaResponseExecution",
          "description": "Condition-type to execute on response if a request on the defined API point happens."
        },
        "function": {
          "$ref": "#/definitions/actionv2betaFunctionExecution",
          "description": "Condition-type to execute if function is used, replaces actions v1."
        },
        "event": {
          "$ref": "#/definitions/actionv2betaEventExecution",
          "description": "Condition-type to execute if an event is created in the system."
        }
      }
    },
    "actionv2betaCreateTargetRequest": {
      "type": "object",
      "example": {
        "name": "ip_allow_list",
        "restWebhook": {
          "interruptOnError": true
        },
        "timeout": "10s",
        "endpoint": "https://example.com/hooks/ip_check"
      },
      "properties": {
        "name": {
          "type": "string",
          "example": "ip_allow_list",
          "maxLength": 1000,
          "minLength": 1
        },
        "restWebhook": {
          "$ref": "#/definitions/actionv2betaRESTWebhook",
          "description": "Wait for response but response body is ignored, status is checked, call is sent as post."
        },
        "restCall": {
          "$ref": "#/definitions/actionv2betaRESTCall",
          "description": "Wait for response and response body is used, status is checked, call is sent as post."
        },
        "restAsync": {
          "$ref": "#/definitions/actionv2betaRESTAsync",
          "description": "Call is executed in parallel to others, Zitadel does not wait until the call is finished. The state is ignored, call is sent as post."
        },
        "timeout": {
          "type": "string",
          "example": "10s",
          "description": "Timeout defines the duration until Zitadel cancels the execution.\nIf the target doesn't respond before this timeout expires, then the connection is closed and the action fails. Depending on the target type and possible setting on `interrupt_on_error` following targets will not be called. In case of a `rest_async` target only this specific target will fail, without any influence on other targets of the same execution."
        },
        "endpoint": {
          "type": "string",
          "example": "https://example.com/hooks/ip_check",
          "maxLength": 1000,
          "minLength": 1
        }
      }
    },
    "actionv2betaCreateTargetResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "69629012906488334",
          "description": "The unique identifier of the newly created target."
        },
        "creationDate": {
          "type": "string",
          "format": "date-time",
          "example": "2024-12-18T07:50:47.492Z",
          "description": "The timestamp of the target creation."
        },
        "signingKey": {
          "type": "string",
          "example": "98KmsU67",
          "description": "Key used to sign and check payload sent to the target."
        }
      }
    },
    "actionv2betaDeleteTargetResponse": {
      "type": "object",
      "properties": {
        "deletionDate": {
          "type": "string",
          "format": "date-time",
          "example": "2025-01-23T10:34:18.051Z",
          "description": "The timestamp of the deletion of the target.\nNote that the deletion date is only guaranteed to be set if the deletion was successful during the request.\nIn case the deletion occurred in a previous request, the deletion date might be empty."
        }
      }
    },
    "actionv2betaEventExecution": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "example": "user.human.added",
          "description": "Event name as condition.",
          "maxLength": 1000,
          "minLength": 1
        },
        "group": {
          "type": "string",
          "example": "user.human",
          "description": "Event group as condition, all events under this group.",
          "maxLength": 1000,
          "minLength": 1
        },
        "all": {
          "type": "boolean",
          "description": "all events as condition."
        }
      }
    },
    "actionv2betaExecution": {
      "type": "object",
      "properties": {
        "condition": {
          "$ref": "#/definitions/actionv2betaCondition"
        },
        "creationDate": {
          "type": "string",
          "format": "date-time",
          "example": "2024-12-18T07:50:47.492Z",
          "description": "The timestamp of the execution creation."
        },
        "changeDate": {
          "type": "string",
          "format": "date-time",
          "example": "2025-01-23T10:34:18.051Z",
          "description": "The timestamp of the last change to the execution."
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered list of targets called during the execution."
        }
      }
    },
    "actionv2betaExecutionFieldName": {
      "type": "string",
      "enum": [
        "EXECUTION_FIELD_NAME_UNSPECIFIED",
        "EXECUTION_FIELD_NAME_ID",
        "EXECUTION_FIELD_NAME_CREATED_DATE",
        "EXECUTION_FIELD_NAME_CHANGED_DATE"
      ],
      "default": "EXECUTION_FIELD_NAME_UNSPECIFIED"
    },
    "actionv2betaExecutionSearchFilter": {
      "type": "object",
      "properties": {
        "inConditionsFilter": {
          "$ref": "#/definitions/actionv2betaInConditionsFilter"
        },
        "executionTypeFilter": {
          "$ref": "#/definitions/actionv2betaExecutionTypeFilter"
        },
        "targetFilter": {
          "$ref": "#/definitions/actionv2betaTargetFilter"
        }
      }
    },
    "actionv2betaExecutionType": {
      "type": "string",
      "enum": [
        "EXECUTION_TYPE_UNSPECIFIED",
        "EXECUTION_TYPE_REQUEST",
        "EXECUTION_TYPE_RESPONSE",
        "EXECUTION_TYPE_EVENT",
        "EXECUTION_TYPE_FUNCTION"
      ],
      "default": "EXECUTION_TYPE_UNSPECIFIED"
    },
    "actionv2betaExecutionTypeFilter": {
      "type": "object",
      "properties": {
        "executionType": {
          "$ref": "#/definitions/actionv2betaExecutionType",
          "description": "Defines the type to query for."
        }
      }
    },
    "actionv2betaFunctionExecution": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "title": "Executed on the specified function"
    },
    "actionv2betaGetTargetResponse": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/actionv2betaTarget"
        }
      }
    },
    "actionv2betaInConditionsFilter": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/actionv2betaCondition"
          },
          "description": "Defines the conditions to query for."
        }
      }
    },
    "actionv2betaInTargetIDsFilter": {
      "type": "object",
      "properties": {
        "targetIds": {
          "type": "array",
          "example": [
            "69629023906488334",
            "69622366012355662"
          ],
          "items": {
            "type": "string"
          },
          "description": "the ids of the targets to include"
        }
      }
    },
    "actionv2betaListExecutionFunctionsResponse": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "All available methods"
        }
      }
    },
    "actionv2betaListExecutionMethodsResponse": {
