    "/v2beta/actions/targets": {
      "post": {
        "summary": "Create Target",
        "description": "Deprecated: please move to the corresponding endpoint under action service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nCreate a new target to your endpoint, which can be used in executions.\n\nRequired permission:\n  - `action.target.write`",
        "operationId": "ActionService_CreateTarget",
        "responses": {
