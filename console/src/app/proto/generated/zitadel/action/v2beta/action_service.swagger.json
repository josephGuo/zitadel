    "/v2beta/actions/targets/{id}": {
      "get": {
        "summary": "Get Target",
        "description": "Deprecated: please move to the corresponding endpoint under action service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nReturns the target identified by the requested ID.\n\nRequired permission:\n  - `action.target.read`",
        "operationId": "ActionService_GetTarget",
        "responses": {
          "200": {
            "description": "Target retrieved successfully",
            "schema": {
              "$ref": "#/definitions/actionv2betaGetTargetResponse"
            }
          },
          "400": {
            "description": "The feature flag `actions` is not enabled.",
            "schema": {}
          },
          "403": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "404": {
            "description": "The target to update does not exist.",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ActionService"
        ],
        "deprecated": true
      },
      "delete": {
        "summary": "Delete Target",
        "description": "Deprecated: please move to the corresponding endpoint under action service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nDelete an existing target. This will remove it from any configured execution as well.\nIn case the target is not found, the request will return a successful response as\nthe desired state is already achieved.\n\nRequired permission:\n  - `action.target.delete`",
        "operationId": "ActionService_DeleteTarget",
        "responses": {
          "200": {
            "description": "Target deleted successfully",
            "schema": {
              "$ref": "#/definitions/actionv2betaDeleteTargetResponse"
            }
          },
          "400": {
            "description": "The feature flag `actions` is not enabled.",
            "schema": {}
