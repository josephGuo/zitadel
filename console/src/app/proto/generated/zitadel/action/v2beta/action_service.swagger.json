            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/actionv2betaCreateTargetRequest"
            }
          }
        ],
        "tags": [
          "ActionService"
        ],
        "deprecated": true
      }
    },
    "/v2beta/actions/targets/search": {
      "post": {
        "summary": "List targets",
        "description": "Deprecated: please move to the corresponding endpoint under action service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nList all matching targets. By default all targets of the instance are returned.\nMake sure to include a limit and sorting for pagination.\n\nRequired permission:\n  - `action.target.read`",
        "operationId": "ActionService_ListTargets",
        "responses": {
          "200": {
            "description": "A list of all targets matching the query",
            "schema": {
